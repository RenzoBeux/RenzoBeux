---
const statement =
  "I build apps end to end: the interface, the backend behind it, and the servers it runs on.";
const words = statement.split(" ");
---

<section id="about" class="about">
  <div class="about-pin">
    <div class="shell">
      <h2 class="eyebrow">About</h2>
      <p class="statement" id="statement" aria-label={statement}>
        {
          words.map((word, i) => (
            <>
              <span aria-hidden="true">{word}</span>
              {i < words.length - 1 ? " " : ""}
            </>
          ))
        }
      </p>
    </div>
  </div>
</section>
