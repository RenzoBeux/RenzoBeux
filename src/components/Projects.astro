---
import { PROJECTS } from "../lib/constants";

const total = String(PROJECTS.length).padStart(2, "0");
const services = [
  ["qBittorrent", ":8080"],
  ["Sonarr", ":8989"],
  ["Radarr", ":7878"],
  ["Prowlarr", ":9696"],
  ["Plex", ":32400"],
];
const containers = ["prowlarr", "sonarr", "radarr", "qbittorrent", "plex"];
---

<section id="projects" class="projects" style={`--n:${PROJECTS.length}`}>
  <div class="stage">
    <div class="stage-head">
      <div class="shell">
        <h2 class="eyebrow">
          Projects
          <span class="stage-count"><span id="proj-count">01</span> / {total}</span>
        </h2>
        <span class="ticks" aria-hidden="true">
          {PROJECTS.map((_, i) => <i class={i === 0 ? "on" : ""} />)}
        </span>
      </div>
    </div>

    {
      PROJECTS.map((project) => (
        <article class="panel" data-viz={project.viz}>
          <div class="shell">
            <div class="panel-copy">
              <h3>
                {project.logo && (
                  <img class="panel-logo" src={project.logo} alt="" width="56" height="56" loading="lazy" />
                )}
                {project.title}
              </h3>
              <p>{project.description}</p>
              <div class="panel-tags">{project.tags.join(" · ")}</div>
              <div class="arrow-links">
                {project.links.map((link) => {
                  const external = link.href.startsWith("http");
                  return (
                    <a
                      href={link.href}
                      target={external ? "_blank" : undefined}
                      rel={external ? "noopener noreferrer" : undefined}
                    >
                      {link.label} {external ? "↗" : "→"}
                    </a>
                  );
                })}
              </div>
            </div>

            <div class="viz" aria-hidden="true">
              {project.viz === "split" && (
                <>
                  <div class="viz-head">
                    <b>Dinner</b>
                    <span class="mono">$96.00</span>
                  </div>
                  <div class="split-bar" data-bar>
                    <i />
                    <i />
                    <i />
                  </div>
                  <div class="split-shares" data-shares>
                    {["You", "Ana", "Leo"].map((name) => (
                      <div>
                        <small>{name}</small>
                        <span class="mono" data-amt>
                          $32.00
                        </span>
                      </div>
                    ))}
                  </div>
                  <div class="split-owes">
                    <div class="on" data-step>Ana → You <span class="mono">$32.00</span></div>
                    <div class="on" data-step>Leo → You <span class="mono">$32.00</span></div>
                  </div>
                </>
              )}

              {project.viz === "services" && (
                <>
                  <div class="viz-head">
                    <b>Services</b>
                    <span class="mono">
                      <span data-count>{services.length}</span> / {services.length} online
                    </span>
                  </div>
                  <div class="svc-rows">
                    {services.map(([name, port]) => (
                      <div class="on" data-step>
                        <span>
                          <i />
                          {name}
                        </span>
                        <em>{port}</em>
                      </div>
                    ))}
                  </div>
                </>
              )}

              {project.viz === "fire" && (
                <>
                  <div class="viz-head">
                    <b>FIRE number</b>
                    <span class="mono">$750,000</span>
                  </div>
                  <div class="fire-chart">
                    <svg data-line viewBox="0 0 300 96" preserveAspectRatio="none">
                      <path d="M0 90 C 90 86, 160 70, 215 42 S 280 16, 300 14" />
                    </svg>
                  </div>
                  <div class="svc-rows fire-rows">
                    <div class="on" data-step>
                      <span>Spending</span>
                      <em>$30,000 / yr</em>
                    </div>
                    <div class="on" data-step>
                      <span>Years to go</span>
                      <em>14</em>
                    </div>
                    <div class="on" data-step>
                      <span>
                        <i />
                        Portfolio holds
                      </span>
                      <em>to age 95</em>
                    </div>
                  </div>
                </>
              )}

              {project.viz === "compose" && (
                <div class="term">
                  <div class="cmd">$ docker compose up -d</div>
                  <div class="on" data-step>
                    <b>✔</b> Network media Created
                  </div>
                  {containers.map((name) => (
                    <div class="on" data-step>
                      <b>✔</b> Container {name} Started
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
