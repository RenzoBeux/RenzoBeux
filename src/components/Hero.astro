---
---

<section id="hero" class="hero">
  <div class="hero-pin">
    <div class="shell">
      <h1 class="hero-name" id="hero-name">
        <span data-src="renzo">Renzo</span>
        <span data-src="beux" class="beux-outline">Beux</span>
      </h1>
      <div class="hero-foot" id="hero-foot">
        <p>
          Software engineer. I build web and mobile apps and run the servers
          behind them.
        </p>
        <span class="eyebrow hero-status"><i></i>Available for opportunities</span>
      </div>
    </div>
  </div>
</section>

<!--
  Fixed copy of the name. scripts/home.ts moves and scales it from the hero
  position into the header wordmark as the page scrolls.
-->
<div id="name-morph" class="hero-name name-morph" aria-hidden="true">
  <span class="w" data-w="renzo">Renzo</span>
  <span class="w" data-w="beux">
    <span class="beux-outline" data-stroke>Beux</span>
    <span class="beux-fill" data-fill>Beux</span>
  </span>
</div>
